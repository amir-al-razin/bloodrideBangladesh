# Copy to backend/.env and change what you need.
DATABASE_URL=postgresql://postgres@localhost:5433/bloodride
FRONTEND_URL=http://localhost:3000

# first alert round
ALERT_RADIUS_KM=10
ALERT_BATCH=10

# demo admin page (real admin login is Sprint 2)
ADMIN_KEY=change-me

# Telegram: create a bot with @BotFather, paste its token and username (without @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
LINK_SECRET=change-this-too

# Tesseract OCR, if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
