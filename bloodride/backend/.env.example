# Copy to backend/.env and change what you need.
DATABASE_URL=postgresql://postgres@localhost:5433/bloodride
FRONTEND_URL=http://localhost:3000

# the search: each round goes further out (km), every WAVE_MINUTES, until a donor says yes
ALERT_RADII_KM=5,10,20,35
ALERT_BATCH=10
WAVE_MINUTES=5

# minutes the hospital has to approve before the BloodRide team is alerted
APPROVE_EMERGENCY_MIN=5
APPROVE_URGENT_MIN=15
APPROVE_SCHEDULED_MIN=60

# Telegram: create a bot with @BotFather, paste its token and username (without @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
LINK_SECRET=change-this-too

# Tesseract OCR, if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
